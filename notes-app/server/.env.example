# You do NOT need to create this file by hand: starting the server creates .env
# automatically, including random JWT secrets. This is only a reference.

PORT=5050
NODE_ENV=development

# Local MongoDB, or an Atlas string like:
# mongodb+srv://<user>:<url-encoded-password>@cluster0.xxxxx.mongodb.net/notes_app
MONGO_URI=mongodb+srv://suhag2908_dbuser:suhag2908@cluster0.pc5x2dm.mongodb.net/


# JWT secrets = any long random string only your server knows. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_EXPIRES=15m
REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173

# First admin, created automatically on start
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
